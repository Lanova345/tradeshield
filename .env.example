# Vercel frontend: add NEXT_PUBLIC_API_URL in Project Settings > Environment Variables.
# Set it to https://<your-api-host>/api/v1 (replace the localhost value below).
# NEXT_PUBLIC_APP_URL is optional and currently unused by the frontend.
# The browser sees NEXT_PUBLIC_* values only; never put secrets in them.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FastAPI backend host only: configure these on the API service, not in Vercel
# unless the API itself is deployed there. Never expose backend secrets with NEXT_PUBLIC_.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
OPENAI_API_KEY=
# Use the Paystack test key (sk_test_...) for testing or live key (sk_live_...) for real payments.
PAYSTACK_SECRET_KEY=
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
JWT_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
# ADMIN_USERNAME and ADMIN_PASSWORD must be set on the backend host.
# For local use, set them in the ignored .env.admin file; do not commit admin credentials.
