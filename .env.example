# Frontend (the browser sees NEXT_PUBLIC_* values only)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend only: never expose these with NEXT_PUBLIC_
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
OPENAI_API_KEY=
# Use the Paystack test key (sk_test_...) for testing or live key (sk_live_...) for real payments.
PAYSTACK_SECRET_KEY=
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
JWT_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
