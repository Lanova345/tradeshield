# FastAPI backend only. Keep secrets out of frontend NEXT_PUBLIC_* variables.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
OPENAI_API_KEY=
# Use the Paystack test key (sk_test_...) for testing or live key (sk_live_...) for real payments.
PAYSTACK_SECRET_KEY=
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
JWT_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
# ADMIN_USERNAME and ADMIN_PASSWORD must be set on the backend host.
# For local use, set them in backend/.env.admin; do not commit admin credentials.
